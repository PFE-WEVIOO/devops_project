            "className": "org.joget.plugin.enterprise.HtmlCodeComponent",
            "properties": {
                "attr-data-events-listening": [],
                "textContent": "<script>\r\nconst API_BASE_URL = \"http://127.0.0.1:5050\";\r\n\r\nasync function loadVMStats(vmLabel) {\r\n    try {\r\n        const response = await fetch(`${API_BASE_URL}/api/vm/stats`, {\r\n            method: 'GET',\r\n            headers: {\r\n                'label': vmLabel,\r\n                'Content-Type': 'application/json'\r\n            }\r\n        });\r\n\r\n        if (!response.ok) throw new Error(`HTTP ${response.status}: ${response.statusText}`);\r\n        const statsArray = await response.json();\r\n        const stats = Array.isArray(statsArray) ? statsArray[0] : statsArray;\r\n\r\n        if (!stats || stats.error) throw new Error(stats?.error || \"Données invalides\");\r\n\r\n        const statsContainer = document.getElementById(`stats-${vmLabel}`);\r\n        if (!statsContainer) return;\r\n\r\n        statsContainer.innerHTML = \"\";\r\n\r\n        const cpu = parseFloat(stats.cpu || 0);\r\n        const ramUsed = stats.ram?.used_mb || 0;\r\n        const ramTotal = stats.ram?.total_mb || 1;\r\n        const ramPercent = ((ramUsed / ramTotal) * 100).toFixed(1);\r\n        const diskUsed = stats.disk?.used || \"N/A\";\r\n        const diskTotal = stats.disk?.size || \"N/A\";\r\n        const diskPercent = parseFloat(stats.disk?.use_percent?.replace('%', '') || 0);\r\n        const ip = stats.ip || \"N/A\";\r\n\r\n        statsContainer.innerHTML += `\r\n            <div><strong>Status:<\/strong> ${stats.status}<\/div>\r\n            <div><strong>IP:<\/strong> ${ip}<\/div>\r\n\r\n            <div><strong>CPU:<\/strong> ${cpu.toFixed(1)}%<\/div>\r\n            <div style=\"background:#eee;width:100%;height:8px;border-radius:5px;\">\r\n                <div style=\"background:#4caf50;height:8px;border-radius:5px;width:${cpu}%\"><\/div>\r\n            <\/div>\r\n\r\n            <div><strong>RAM:<\/strong> ${ramUsed}MB / ${ramTotal}MB (${ramPercent}%)<\/div>\r\n            <div style=\"background:#eee;width:100%;height:8px;border-radius:5px;\">\r\n                <div style=\"background:#2196f3;height:8px;border-radius:5px;width:${ramPercent}%\"><\/div>\r\n            <\/div>\r\n\r\n            <div><strong>Disk:<\/strong> ${diskUsed} / ${diskTotal} (${diskPercent}%)<\/div>\r\n            <div style=\"background:#eee;width:100%;height:8px;border-radius:5px;\">\r\n                <div style=\"background:#f44336;height:8px;border-radius:5px;width:${diskPercent}%\"><\/div>\r\n            <\/div>\r\n        `;\r\n\r\n    } catch (error) {\r\n        const statsContainer = document.getElementById(`stats-${vmLabel}`);\r\n        if (statsContainer) {\r\n            statsContainer.innerHTML = `<p style=\"color:red;\">❌ ${error.message}<\/p>`;\r\n        }\r\n    }\r\n}\r\n<\/script>\r\n",
                "id": "3506207F26CB4E2176DD65E7FD796980",
                "customId": "const_api_base_url_http_127_0"
            }
        },
